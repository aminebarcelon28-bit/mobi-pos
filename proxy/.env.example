TURSO_URL=libsql://your-db-username.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...
TOKEN_TTL_SECONDS=3600
PORT=8787
ALLOW_ORIGIN=*
# B-041: REQUIRED in production — clients must send Authorization: Bearer <this>
BROKER_SECRET=change-me-long-random
# Optional comma-separated deviceId allow-list; empty = any authenticated device
ALLOWED_DEVICES=
# Sliding-window rate limit per client IP (default 30)
RATE_LIMIT_PER_MIN=30
NODE_ENV=development
