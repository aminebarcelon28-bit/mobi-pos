{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MobiPOS",
  "version": "1.3.1",
  "identifier": "com.mobi.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MOBI ACCESSORIES POS",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MzE2Q0I0QjNFQjI0NjQKUldSa0pPdXp0R3d4MWN5SUtDVHhEUEo1c3lLNjl2M0gxSURMMkhpRGswdHladnVlampGQ1d6VXoK",
      "endpoints": [
        "https://github.com/aminebarcelon28-bit/mobi-pos/releases/latest/download/latest.json"
      ]
    }
  }
}
