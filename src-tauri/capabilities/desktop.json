{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only: auto-updater + process (gated #[cfg(desktop)] in lib.rs)",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "process:default",
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://wa.me/*" },
        { "url": "https://api.whatsapp.com/*" },
        { "url": "https://github.com/aminebarcelon28-bit/*" },
        { "url": "https://apps.apple.com/*" },
        { "url": "https://play.google.com/*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
