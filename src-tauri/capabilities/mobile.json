{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile",
  "description": "Mobile: core + SQLite only (no updater/process on iOS/Android)",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://wa.me/*" },
        { "url": "https://api.whatsapp.com/*" },
        { "url": "https://github.com/aminebarcelon28-bit/*" },
        { "url": "https://apps.apple.com/*" },
        { "url": "https://play.google.com/*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
