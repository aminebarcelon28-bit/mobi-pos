 /// Current durable high-water (diagnostics; `None` before first anchor).
 pub fn current_high_water(conn: &rusqlite::Connection) -> Option<i64> {
     conn.query_row("SELECT high_water_ms FROM time_anchor WHERE id = 1", [], |r| {
         r.get(0)
     })
     .ok()
