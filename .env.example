# Frontend env (copy to .env, never commit real URLs with tokens)
# SyncManager POSTs { deviceId } here to get a short-lived Turso token.
VITE_SYNC_PROXY_URL=http://localhost:8787/api/sync-token
# B-041: broker secret — must match proxy/.env BROKER_SECRET (Authorization: Bearer)
VITE_SYNC_BROKER_SECRET=
# B-042: relay admin secret — must match wrangler ADMIN_SECRET (device routes)
VITE_RELAY_ADMIN_SECRET=
# B-062: optional override for the signal-relay WebSocket.
# Default: wss://relay.mobipos.app/room/<merchant>. Leave unset unless the
# Worker is deployed elsewhere (local: ws://127.0.0.1:8787/room/<merchant>).
# If unset AND relay.mobipos.app does not resolve, the app falls back to
# 1.5s polling (SYNC PROXY still required for data).
VITE_RELAY_WS_URL=
