# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env + secrets (Turso tokens live here — NEVER commit)
.env
.env.local
.env.licensing
workers/licensing/.dev.vars
licenses_ledger.json
*.vault
proxy/.env

# Tauri Signing Keys & Target
*.key
*.key.pub
*.sig
src-tauri/target
src-tauri/target_check
target/
/target

# Test scratch artifacts — regression suites create these at runtime
# (tmp-*.db SQLite copies, _testall_out.txt capture, tmp-h28-shim/ shim tree).
# Never commit: they are run leftovers, not source.
tmp-*.db
tmp-*.db-*
tmp-*-shim/
_testall_out.txt
scripts/_*.mjs
scripts/_*.txt

# Licensing for MobiPOS - frozen build artifacts
build/
licensing_dist/

# Python bytecode. Seven .pyc files were committed under admin_desktop/
# before this rule existed; they are build output, not source.
__pycache__/
*.py[cod]
*.pyd

# Worker provisioning
workers/licensing/.dev.vars

# E2E / test build target dirs (custom echoes of `src-tauri/target`; ~5 GB
# of Rust artifacts from scripts/build-e2e.mjs and the test profile).
target-e2e/
target-test/
src-tauri/target-e2e/
src-tauri/target-test/

# WDIO run logs + generated manifests (test-logs/ is wiped every run).
test-logs/
# Playwright / WebDriver report output.
test-results/

# Scratch DBs the regression suites create/leave at the repo root.
test_*.db

# Ad-hoc screenshots dropped at the repo root.
/*.png

# Local agent/tool caches and captured evidence trees (large binaries,
# DB backups, screenshot dumps — prior-session scratch, not source).
.kilo/
.playwright-mcp/
artifacts/

# The e2e-testing skill is SOURCE ONLY (SKILL.md, references, scripts,
# templates). Generated output — evidence bundles, run sidecars, logs — is
# never committed inside it, even if a future session writes one there.
.opencode/skills/e2e-testing/**/evidence/
.opencode/skills/e2e-testing/**/runs/
.opencode/skills/e2e-testing/**/*.sidecar.json
.opencode/skills/e2e-testing/**/*.log

# E2E run output and local-only fixtures. Nothing here is source: run logs,
# evidence bundles, pulled device DBs, state tarballs, built APKs and signing
# material are all generated on the machine that runs the suite.
e2e-tests/results/
e2e-tests/test-logs/
e2e-tests/logs/
e2e-tests/TEST_EVIDENCE/
e2e-tests/long/
e2e-tests/mobile/tmp/
e2e-tests/mobile/tmp-*
e2e-tests/mobile/fixtures/
# One-off scratch scripts (REPL-style probes, not part of the suite).
e2e-tests/tmp-*
e2e-tests/**/*.png
e2e-tests/**/*.webm
e2e-tests/**/*.ndjson

# Databases, archives, mobile packages and signing material never belong in
# git. A real shop DB was once copied in as a "baseline"; this blocks repeats.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.tar.gz
*.apk
*.aab
*.jks
*.keystore
keystore.properties




# Generated by e2e-tests/lib/invariants.ts on every run (Q-D).
results/invariant-events.ndjson
agent/cache/
